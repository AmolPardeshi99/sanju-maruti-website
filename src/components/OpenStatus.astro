---
import { openingHours } from '../data/site';
// Text is filled in by the script below; the server fallback reads fine without JavaScript.
---
<span data-open-status class="inline-flex items-center gap-2 whitespace-nowrap text-xs font-medium text-paper/80">
  <span data-open-dot class="h-2 w-2 rounded-full bg-paper/40"></span>
  <span data-open-text>Mon–Sat 9 AM – 6 PM</span>
</span>

<script define:vars={{ hours: JSON.stringify(openingHours) }}>
  const config = JSON.parse(hours);
  const root = document.querySelector('[data-open-status]');
  const dot = root.querySelector('[data-open-dot]');
  const text = root.querySelector('[data-open-text]');
  const names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const fmt = (h) => (h === 12 ? '12 PM' : h > 12 ? `${h - 12} PM` : `${h} AM`);

  const local = () => {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: config.timeZone, weekday: 'short', hour: 'numeric', hourCycle: 'h23',
    }).formatToParts(new Date());
    const get = (type) => parts.find((p) => p.type === type).value;
    const day = names.indexOf(get('weekday'));
    const hour = Number(get('hour'));
    const today = new Date(Date.now() + 5.5 * 3600 * 1000).toISOString().slice(0, 10);
    return { day, hour, today };
  };

  const update = () => {
    const { day, hour, today } = local();
    const override = config.overrides[today];
    const todayClosed = override === 'closed' || config.holidays.includes(today);
    const open = override && override !== 'closed' ? override : { open: config.openHour, close: config.closeHour };
    const closed = (d) => config.closedWeekdays.includes(d);
    if (!todayClosed && !closed(day) && hour >= open.open && hour < open.close) {
      text.textContent = `Open · till ${fmt(open.close)}`;
      dot.className = 'h-2 w-2 rounded-full bg-emerald-400';
      return;
    }
    let next = null;
    for (let k = 0; k < 8 && next === null; k++) {
      const d = (day + k) % 7;
      if (k === 0 && (todayClosed || closed(d) || hour >= open.open)) continue;
      if (!closed(d)) next = { d, k };
    }
    const label = next.k === 0 ? 'today' : next.k === 1 ? 'tomorrow' : names[next.d];
    text.textContent = `Closed · opens ${label} ${fmt(open.open)}`;
    dot.className = 'h-2 w-2 rounded-full bg-paper/40';
  };

  update();
  setInterval(update, 60000);
</script>
