---
import Layout from '../../layouts/Layout.astro';
import PriceNote from '../../components/PriceNote.astro';
import { services, getService } from '../../data/services';
import { whatsappLink, site } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}

const service = getService(Astro.params.slug!);
if (!service) throw new Error(`Unknown service: ${Astro.params.slug}`);
---

<Layout title={`${service.name} | Sanju Maruti Services`} description={service.summary}>
  <section class="mx-auto max-w-site px-4 py-16">
    <a href="/services" class="text-sm text-muted hover:text-brass">← All services</a>
    <h1 class="mt-4 text-4xl font-semibold md:text-5xl">{service.name}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{service.summary}</p>
    <div class="mt-6"><PriceNote /></div>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={whatsappLink(`Hi, I want to book: ${service.name}.`)} target="_blank" rel="noopener" class="rounded-full bg-brass px-6 py-3 font-semibold text-ink hover:bg-brass-deep">Book on WhatsApp</a>
      <a href={`tel:${site.phone}`} class="rounded-full border border-ink px-6 py-3 font-semibold hover:bg-ink hover:text-paper">Call now</a>
    </div>
  </section>
</Layout>
