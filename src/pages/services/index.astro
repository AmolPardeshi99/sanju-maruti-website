---
import Layout from '../../layouts/Layout.astro';
import PriceNote from '../../components/PriceNote.astro';
import { services } from '../../data/services';
import { whatsappLink } from '../../data/site';
---

<Layout title="Services | Sanju Maruti Services" description="Periodic service, AC, denting-painting, car wash, ceramic coating, tyres, battery, engine and towing for all brands.">
  <section class="mx-auto max-w-site px-4 py-16">
    <h1 class="text-4xl font-semibold md:text-5xl">Our services</h1>
    <p class="mt-4 max-w-2xl text-muted">Service for every brand, from routine maintenance to coating and repairs.</p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <li>
          <a href={`/services/${s.slug}`} class="block h-full rounded-xl border border-ink/10 bg-white p-6 transition hover:border-brass">
            <h2 class="text-xl font-semibold">{s.name}</h2>
            <p class="mt-2 text-sm text-muted">{s.summary}</p>
            <div class="mt-4"><PriceNote /></div>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-12">
      <a href={whatsappLink('Hi, I want to ask about a service.')} target="_blank" rel="noopener" class="rounded-full bg-brass px-6 py-3 font-semibold text-ink hover:bg-brass-deep">Ask on WhatsApp</a>
    </div>
  </section>
</Layout>
