---
import Layout from '../layouts/Layout.astro';
import { site, whatsappLink } from '../data/site';
---

<Layout title="Contact | Sanju Maruti Services" description="Visit Sanju Maruti Services at Jargaon Crossing, Pachora Road, Jalgaon. Call or WhatsApp on +91 99750 49393.">
  <section class="mx-auto max-w-site px-4 py-16">
    <h1 class="text-4xl font-semibold md:text-5xl">Contact us</h1>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <div class="space-y-6">
        <div>
          <h2 class="text-lg font-semibold">Address</h2>
          <p class="mt-1 text-muted">{site.address.line}</p>
          <p class="text-muted">{site.address.city}, {site.address.region}</p>
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="mt-3 inline-block text-brass-deep underline">Get directions</a>
        </div>

        <div>
          <h2 class="text-lg font-semibold">Phone and WhatsApp</h2>
          <p class="mt-1"><a href={`tel:${site.phone}`} class="text-brass-deep underline">{site.phoneDisplay}</a></p>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="mt-3 inline-block rounded-full bg-brass px-6 py-3 font-semibold text-ink hover:bg-brass-deep">Message on WhatsApp</a>
        </div>

        <div>
          <h2 class="text-lg font-semibold">Hours</h2>
          <p class="mt-1 text-muted">{site.hours}</p>
          <p class="text-muted">{site.closedDay}</p>
          <p class="mt-2 text-brass-deep">{site.towing}</p>
        </div>
      </div>

      <div class="rounded-xl bg-ink-2 p-8 text-paper">
        <h2 class="text-lg font-semibold">Serving</h2>
        <ul class="mt-3 grid grid-cols-2 gap-2 text-paper/80">
          {site.areas.map((area) => <li>{area}</li>)}
        </ul>
        <p class="mt-6 text-sm text-paper/70">Based on Pachora Road near Hindustan Tyre, Jargaon Crossing.</p>
      </div>
    </div>
  </section>
</Layout>
